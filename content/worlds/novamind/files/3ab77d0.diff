+// nova-widget: prise de rendez-vous
+const API = process.env.NOVA_API_URL;
+const KEY = process.env.NOVA_API_KEY;
+
+export async function book(clinic, slot) {
+  return fetch(`${API}/appointments`, {
+    method: 'POST',
+    headers: { authorization: `Bearer ${KEY}` },
+    body: JSON.stringify({ clinic, slot }),
+  });
+}
