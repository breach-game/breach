{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": { "includes": ["**", "!**/dist", "!**/public/packs", "!docs/mockups", "!**/*.css"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noControlCharactersInRegex": "off", "noArrayIndexKey": "off" },
      "a11y": { "noStaticElementInteractions": "off", "useKeyWithClickEvents": "off" }
    }
  }
}
